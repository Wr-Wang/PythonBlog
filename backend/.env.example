# SQL Server（pyodbc），须安装 ODBC Driver 17 或 18，driver= 与系统一致
DATABASE_URL=mssql+pyodbc://sa:你的密码@localhost/BlogDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# 命名实例：\\ 写成 %5C，例如 localhost%5CSQLEXPRESS

SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://www.blogapi.com:80
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
