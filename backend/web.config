<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + HttpPlatformHandler。若 venv\Scripts\python.exe 在应用池身份下报错「No Python at …」，
  可改用本机已安装依赖的 python.exe（须与 pip 安装依赖时一致），并保留 PYTHONPATH 指向 backend。
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Users\Administrator\AppData\Local\Programs\Python\Python312\python.exe" arguments="-m iis_entry" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" startupTimeLimit="120" startupRetryCount="10">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="e:\Demo\Cursor\PythonBlog\backend" />
      </environmentVariables>
    </httpPlatform>
        <directoryBrowse enabled="true" />
  </system.webServer>
</configuration>
